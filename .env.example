# Stravifx — settings.
#
# ── The site (Vercel / .env) ────────────────────────────────────────────────
# The site needs only the public address of the Supabase project. No secrets.
NEXT_PUBLIC_SUPABASE_URL=

# ── Supabase Edge Function secrets ──────────────────────────────────────────
# These do NOT go on Vercel. Set them in Supabase → Edge Functions → Secrets,
# or with:  npx supabase secrets set NAME=value
# The Learn checkout stays closed ("Checkout opens soon") until the three
# required ones are set.

# Paystack secret key (Paystack → Settings → API Keys & Webhooks). Required.
# The name Live_Secret_Key is also accepted.
PAYSTACK_SECRET_KEY=

# Price as a plain number in whole units, e.g. 25 for $25. Required.
# Don't type a $ sign in the terminal: the shell swallows it.
LEARN_PRICE_AMOUNT=

# The site's public address, e.g. https://www.stravifx.app. Required: buyers
# are sent back here after paying.
SITE_URL=

# Currency your Paystack account accepts: USD, KES, ... Defaults to KES.
LEARN_PRICE_CURRENCY=USD

# Optional one-liner shown under the pay button, e.g.
# "Fully refundable until the first cohort opens."
LEARN_REFUND_POLICY=
